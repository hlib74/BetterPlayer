{
    "manifest_version": 3,
    "name": "BetterPlayer",
    "version": "1.0",
    "description": "BetterPlayer - Customize audio EQ, playback rate, filters, and privacy mask, with automatic tab suspension.",
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "storage",
        "tabGroups",
        "downloads",
        "tabCapture",
        "offscreen",
        "alarms"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/logo16.png",
        "32": "icons/logo32.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
    },
    "action": {
        "default_title": "BetterPlayer",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/logo16.png",
            "32": "icons/logo32.png",
            "48": "icons/logo48.png",
            "128": "icons/logo128.png"
        }
    }
}